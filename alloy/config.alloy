// ── Grafana Alloy configuration ───────────────────────────────────────────────
// Collects logs from Docker containers and forwards to Loki.
// Also accepts Faro RUM payloads from the frontend and routes to Loki + Tempo.

// ── Docker log source ─────────────────────────────────────────────────────────
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.all.targets
  labels     = { "job" = "docker" }
  forward_to = [loki.process.add_labels.receiver]
}

discovery.docker "all" {
  host = "unix:///var/run/docker.sock"
}

// ── Log processing — enrich with container metadata ───────────────────────────
loki.process "add_labels" {
  forward_to = [loki.write.loki.receiver]

  stage.docker {}

  stage.labels {
    values = {
      container = "attrs[\"container_name\"]",
      stream    = "stream",
    }
  }

  stage.json {
    expressions = {
      level   = "levelname",
      message = "message",
      logger  = "name",
    }
  }

  stage.label_drop {
    values = ["filename"]
  }
}

// ── Loki write ────────────────────────────────────────────────────────────────
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    env         = "local",
    app         = "url-shortener",
  }
}

// ── Faro receiver (RUM from frontend) ────────────────────────────────────────
faro.receiver "frontend" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs   = [loki.write.loki.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// ── OTel trace forward to Tempo ───────────────────────────────────────────────
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "http://tempo:4317"
    tls {
      insecure = true
    }
  }
}
